        <actions>
          <action name="Alimentar_entry">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Banda_Alimentacion := TRUE;
//Limpia la falla si la cortina ests libre y se pulsa recet
IF Reset_Seguridad AND Cortina_Seguridad_OK THEN
	Falla_Seguridad := FALSE;
END_IF;
//Si se interrumpe cortina estando en reposo se bloque el arranque
IF NOT Cortina_Seguridad_OK THEN
	Falla_Seguridad := TRUE;
END_IF;
Luz_Alarma_Seguridad := Falla_Seguridad;</xhtml>
              </ST>
            </body>
